{
  "name": "filizlenio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketing": "pnpm --filter @filizlen/marketing dev",
    "dev:web": "pnpm --filter @filizlen/web-app dev",
    "dev:api": "pnpm --filter @filizlen/api dev",
    "build": "turbo run build",
    "build:marketing": "pnpm --filter @filizlen/marketing build",
    "build:web": "pnpm --filter @filizlen/web-app build",
    "build:api": "pnpm --filter @filizlen/api build",
    "lint": "turbo run lint",
    "start:marketing": "pnpm --filter @filizlen/marketing start:prod",
    "start:web": "pnpm --filter @filizlen/web-app start:prod"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@filizlen/mobile>@types/react": "~18.3.12"
    }
  }
}
